{
  "name": "tanstack-start-tutorial-yt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "post-cta-init": "pnpm dlx create-db@latest --user-agent tanstack/tsrouter",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "^1.1.0",
    "@tanstack/ai-openrouter": "^1.1.0",
    "@tanstack/ai-react": "^1.0.2",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.1",
    "ai": "^7.0.162",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firecrawl": "^4.50.0",
    "lucide-react": "^1.57.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "prisma": "^7.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@prisma/engines",
      "prisma"
    ]
  }
}